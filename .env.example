# Copy this file to .env.local and fill in your Supabase project's values.
# Supabase dashboard > Project Settings > API Keys (or the "Connect" button).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# The publishable (anon) key. Never put the secret / service_role key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
